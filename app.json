{
  "expo": {
    "name": "ai-studio-app",
    "slug": "ai-studio-app",
    "version": "1.0.0",
    "scheme": "coffeeshop",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": ["node_modules/@expo-google-fonts/plus-jakarta-sans/plus_jakarta_sans.css"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
